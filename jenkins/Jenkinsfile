pipeline {
    agent any

    environment {
        DATABASE_URL = credentials('DATABASE_URL')
        TEST_DATABASE_URL = credentials('TEST_DATABASE_URL')
        APP_ENV = 'staging'
    }

    stages {
        stage('Unit Tests') {
            parallel {
                stage('Unit Tests - Backend') {
                    agent {
                        docker {
                            image 'golang:1.25'
                            reuseNode true
                        }
                    }
                    steps {
                        dir('bugtracker-backend') {
                            sh '''
                                # Set Go cache to a writable location
                                export GOCACHE="$PWD/.cache/go-build"
                                export GOMODCACHE="$PWD/.cache/go-mod"

                                # Create cache directories
                                mkdir -p "$GOCACHE" "$GOMODCACHE"

                                # Install go-junit-report tool
                                go install github.com/jstemmer/go-junit-report@latest

                                # Run tests and produce test result report
                                go test -v ./... 2>&1 | go-junit-report > test-results.xml

                                # Generate coverage report
                                go test -coverprofile=coverage.out -covermode=atomic ./...
                                go tool cover -html=coverage.out -o coverage.html

                                # Create reports directory and move coverage report here
                                mkdir -p reports
                                mv coverage.html reports/
                            '''
                        }
                    }
                    post {
                        always {
                            junit 'bugtracker-backend/test-results.xml'
                            publishHTML target: [
                                reportName: 'Backend Coverage Report',
                                reportDir: 'bugtracker-backend/reports',
                                reportFiles: 'coverage.html',
                            ]
                        }
                    }
                }

                stage('Unit Tests - Frontend') {
                    agent {
                        docker {
                            image 'node:24-alpine'
                            reuseNode true
                        }
                    }
                    steps {
                        dir('bugtracker-frontend') {
                            sh '''
                                # Install dependencies
                                npm ci

                                # Run tests
                                npm test

                                # Create directory for coverage report and move it there
                                mkdir -p reports
                                mv coverage reports/
                            '''
                        }
                    }
                    post {
                        always {
                            junit 'bugtracker-frontend/test-results.xml'
                            publishHTML target: [
                                reportName: 'Frontend Coverage Report',
                                reportDir: 'bugtracker-frontend/reports/coverage',
                                reportFiles: 'index.html',
                            ]
                        }
                    }
                }
            }
        }

        stage('Launch App') {
            agent {
                docker {
                    image 'docker:27.5.1'
                    reuseNode true
                    args '-v /var/run/docker.sock:/var/run/docker.sock -u 0'
                }
            }
            steps {
                //Build and run the application
                sh 'docker compose up -d --build'
            }
        }

        stage('Test App') {
            parallel {
                stage('API Tests') {
                    agent {
                        docker {
                            image 'mcr.microsoft.com/playwright:v1.50.0-jammy'
                            reuseNode true
                            args '--network=host'
                        }
                    }
                    steps {
                        dir('tests-api') {
                            // Wait for the application to be ready before running tests
                            sh 'npx wait-port http://localhost:8080/api/health -t 30000'
                            sh 'npm ci && npx playwright test'
                        }
                    }
                    post {
                        always {
                            junit 'tests-api/test-results/results.xml'
                            publishHTML target: [
                                reportName: 'API Test Results',
                                reportDir: 'tests-api/playwright-report',
                                reportFiles: 'index.html',
                            ]
                        }
                    }
                }

                stage('Performance Tests') {
                    agent {
                        docker {
                            image 'grafana/k6:latest'
                            reuseNode true
                            args '--network=host --entrypoint=""'
                        }
                    }
                    steps {
                        dir('tests-perf') {
                            sh 'k6 run script.js'
                        }
                    }
                    post {
                        always {
                            publishHTML target: [
                                reportName: 'Performance Test Results',
                                reportDir: 'tests-perf',
                                reportFiles: 'perf-results.html',
                            ]
                        }
                    }
                }
            }
        }

        stage('Deploy Staging') {
            when {
                expression {
                    return env.GIT_BRANCH == 'origin/main'
                }
            }
            environment {
                DEPLOY_URL_BACKEND_STAGING = credentials('RENDER_DEPLOY_BACKEND_STAGING')
                DEPLOY_URL_FRONTEND_STAGING = credentials('RENDER_DEPLOY_FRONTEND_STAGING')
                RENDER_API_KEY = credentials('RENDER_API_KEY')
                STAGING_BACKEND_SERVICEID = credentials('STAGING_BACKEND_SERVICEID')
                STAGING_FRONTEND_SERVICEID = credentials('STAGING_FRONTEND_SERVICEID')
            }
            steps {
                sh '''
                    #!/bin/bash
                    set -e

                    deploy_and_wait() {
                        DEPLOY_HOOK_URL=$1
                        SERVICE_ID=$2
                        SERVICE_NAME=$3

                        echo "🚀 Start deployment for $SERVICE_NAME"
                        DEPLOY_ID=$(curl "$DEPLOY_HOOK_URL" | jq -r '.deploy.id')

                        if [ -z "$DEPLOY_ID" ] || [ "$DEPLOY_ID" = "null" ]; then
                            echo "No deploy ID returned"
                            exit 1
                        fi

                        # Poll deployment status every 5 seconds
                        echo "⏱️Polling status of deployment $DEPLOY_ID"

                        i=1
                        while [ "$i" -le 30 ]; do
                            STATUS=$(curl -sS --fail \
                            --request GET \
                            --url "https://api.render.com/v1/services/$SERVICE_ID/deploys/$DEPLOY_ID" \
                            --header "Authorization: Bearer $RENDER_API_KEY" \
                            | jq -r '.status')

                            echo "$SERVICE_NAME deployment status: $STATUS"
                            if [ "$STATUS" = "live" ]; then
                                echo "✅ $SERVICE_NAME deployment is live!🎉"
                                return 0
                            fi

                            case "$STATUS" in
                            *"failed"*|*"canceled"*|*"deactivated"*)
                                echo "❌ $SERVICE_NAME deployment failed with status: $STATUS"
                                exit 1
                                ;;
                            esac

                            sleep 5
                            i=$((i + 1))
                        done

                        echo "$SERVICE_NAME deployment did not become live within expected time"
                        exit 1
                    }

                    # Deploy backend first
                    deploy_and_wait \
                    "$DEPLOY_URL_BACKEND_STAGING" \
                    "$STAGING_BACKEND_SERVICEID" \
                    "bugtracker-backend-staging-kamui"

                    # Deploy frontend only if backend succeeded
                    deploy_and_wait \
                    "$DEPLOY_URL_FRONTEND_STAGING" \
                    "$STAGING_FRONTEND_SERVICEID" \
                    "bugtracker-frontend-staging-kamui"
                '''
            }
        }

        stage('Post Deployment Tests') {
            when {
                expression {
                    return env.GIT_BRANCH == 'origin/main'
                }
            }
            agent {
                docker {
                    image 'mcr.microsoft.com/playwright:v1.50.0-jammy'
                    reuseNode true
                }
            }
            environment {
                STAGING_APP_BASE_URL = credentials('STAGING_APP_URL')
            }
            steps {
                dir('tests-e2e') {
                    sh 'npm ci && npx playwright test'
                }
            }
            post {
                always {
                    junit 'tests-e2e/test-results/results.xml'
                    publishHTML target: [
                        reportName: 'Post-Deployment Test Results',
                        reportDir: 'tests-e2e/playwright-report',
                        reportFiles: 'index.html',
                    ]
                }
            }
        }

        stage('Deploy Production') {
            when {
                expression {
                    return env.GIT_BRANCH == 'origin/main'
                }
            }
            environment {
                DEPLOY_URL_BACKEND_PROD = credentials('RENDER_DEPLOY_BACKEND_PROD')
                DEPLOY_URL_FRONTEND_PROD = credentials('RENDER_DEPLOY_FRONTEND_PROD')
                RENDER_API_KEY = credentials('RENDER_API_KEY')
                PROD_BACKEND_SERVICEID = credentials('PROD_BACKEND_SERVICEID')
                PROD_FRONTEND_SERVICEID = credentials('PROD_FRONTEND_SERVICEID')
            }
            steps {
                sh '''
                    #!/bin/bash
                    set -e

                    deploy_and_wait() {
                        DEPLOY_HOOK_URL=$1
                        SERVICE_ID=$2
                        SERVICE_NAME=$3

                        echo "🚀 Start deployment for $SERVICE_NAME"
                        DEPLOY_ID=$(curl "$DEPLOY_HOOK_URL" | jq -r '.deploy.id')

                        if [ -z "$DEPLOY_ID" ] || [ "$DEPLOY_ID" = "null" ]; then
                            echo "No deploy ID returned"
                            exit 1
                        fi

                        # Poll deployment status every 5 seconds
                        echo "⏱️Polling status of production deployment $DEPLOY_ID"

                        i=1
                        while [ "$i" -le 30 ]; do
                            STATUS=$(curl -sS --fail \
                            --request GET \
                            --url "https://api.render.com/v1/services/$SERVICE_ID/deploys/$DEPLOY_ID" \
                            --header "Authorization: Bearer $RENDER_API_KEY" \
                            | jq -r '.status')

                            echo "$SERVICE_NAME production deployment status: $STATUS"
                            if [ "$STATUS" = "live" ]; then
                                echo "✅ $SERVICE_NAME successfully deployed to production!🎉"
                                return 0
                            fi

                            case "$STATUS" in
                            *"failed"*|*"canceled"*|*"deactivated"*)
                                echo "❌ $SERVICE_NAME failed to deploy to production with status: $STATUS"
                                exit 1
                                ;;
                            esac

                            sleep 5
                            i=$((i + 1))
                        done

                        echo "$SERVICE_NAME deployment did not become live in production within expected time"
                        exit 1
                    }

                    # Deploy backend first
                    deploy_and_wait \
                    "$DEPLOY_URL_BACKEND_PROD" \
                    "$PROD_BACKEND_SERVICEID" \
                    "bugtracker-backend-kamui"

                    # Deploy frontend only if backend succeeded
                    deploy_and_wait \
                    "$DEPLOY_URL_FRONTEND_PROD" \
                    "$PROD_FRONTEND_SERVICEID" \
                    "bugtracker-frontend-kamui"
                '''
            }
        }
    }

    post {
        always {
            cleanWs(
                deleteDirs: true
            )
        }
    }
}
